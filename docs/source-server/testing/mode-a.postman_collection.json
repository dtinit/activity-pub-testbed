          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Deliberately invalid credentials for the refusal checks, set at run time so Postman's",
              "// secret scanner does not mistake them for real ones stored in the collection",
              "pm.variables.set('invalid_token', 'not-a-valid-token');",
              "pm.variables.set('wrong_client_secret', 'not-the-client-secret');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A browser-based destination cannot read an error that lacks CORS",
              "const body = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "if (body && body.error_code) {",
              "    pm.test('The error carries Access-Control-Allow-Origin: *', () => {",
              "        pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('*');",
              "    });",
              "}"
            ]
          }
        }
