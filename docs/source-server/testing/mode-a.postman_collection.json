              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{token_endpoint}}",
            "description": "An authorization code is single-use (RFC 6749 §4.1.2). Runs after every request that needs the\ntoken, in case the server revokes tokens issued from a replayed code.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
